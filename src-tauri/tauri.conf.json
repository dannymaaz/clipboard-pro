{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipboard Pro",
  "version": "0.1.9",
  "identifier": "com.dannymaaz.clipboardpro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "Copyright Danny Maaz",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Fast local clipboard upgrade",
    "longDescription": "Clipboard Pro is a fast, private, local-first clipboard manager for Windows, macOS and Linux."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGNzlGN0U4MjcyRjJGRDgKUldUWUx5OG42UGQ1TDVxQU5OSFI3eEpicVJOVjNEUEJ4S0lERCthSUFkakRPT1phSDI2ZUhwenIK",
      "endpoints": [
        "https://github.com/dannymaaz/clipboard-pro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
